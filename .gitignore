# Configuración local de Claude Code (no es parte del sitio)
.claude/

# Basura de Windows y OneDrive
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS, por si alguien abre esto desde una Mac
.DS_Store

# Editores
.vscode/
.idea/
*.swp
*~

# Fotos originales sin procesar (pesan 9 MB y no se publican).
# Las versiones optimizadas viven en assets/img/*.jpg
assets/img/fotos/

# Lote nuevo de Kaffa, todavía sin procesar. Netlify publica la raíz del
# repositorio, así que si esto entrara al commit se subiría tal cual, con
# nombre de WhatsApp incluido.
assets/img/Fotos nuevas/

# Videos crudos (los .mp4 de WhatsApp y las descargas de YouTube). Mismo motivo
# que las fotos: Netlify publica la raíz, así que ni al commit ni al sitio.
# Las excepciones son los dos ya comprimidos para la web, que sí tienen que
# viajar al sitio: vandola.mp4 (2,5 MB) es el video de la portada y
# cold-brew.mp4 (1,2 MB) es la cuarta tarjeta de la sección de videos.
assets/video/*
!assets/video/vandola.mp4
!assets/video/cold-brew.mp4
